// quad grid over the (section, profile-point) torus topology, split to triangles
faces = [
    for (i = [0:N-1], j = [0:M-1])
        let (i2 = (i + 1) % N, j2 = (j + 1) % M,
             a = i*M + j, b = i*M + j2, cc = i2*M + j2, d = i2*M + j)
        each [[a, cc, b], [a, d, cc]]
];

module bezel() {
    polyhedron(points = points, faces = faces, convexity = 10);
}

bezel();
