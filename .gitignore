/target
**/*.rs.bk
Cargo.lock.bak

# local Claude / editor settings
.claude/settings.local.json
*.local.*

# runtime workspace produced by the server
/workspace/

# OS noise
.DS_Store

# per-project generated outputs
projects/**/artifacts/
projects/**/.demiourgos/
projects/**/*.bgcode

# downloaded reference models (do not redistribute third-party STLs)
projects/**/reference/*.stl
projects/**/reference/*.3mf
projects/**/reference/*.zip
projects/**/reference/*.step

# downloaded reference / inspiration photos (third-party — keep local, never commit).
# Our own renders are .png and stay tracked.
projects/**/*.webp
projects/**/*.jpg
projects/**/*.jpeg
projects/**/*.gif
projects/**/*.heic
projects/**/*.avif

# think-and-ship reasoning/exec trace (local)
.think-and-ship/

# local reference-analysis wrappers (import git-ignored STLs)
projects/**/ref_*.scad
